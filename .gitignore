# ==========================================
# NagriVanta - Root Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# ==========================================
# Environment Variables & Secrets
# ==========================================

.env
.env.*
**/.env
**/.env.*

# Allow example environment files
!.env.example
!**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.p8
*.jks
*.keystore

# ==========================================
# Build Files & Generated Output
# ==========================================

dist/
**/dist/
build/
**/build/
dist-ssr/
.expo/
**/.expo/
web-build/
coverage/

# ==========================================
# React / Vite
# ==========================================

.vercel/
**/.vercel/

# ==========================================
# Expo / React Native
# ==========================================

.expo-shared/
.metro-health-check*
expo-env.d.ts

# Generated native folders
ios/
android/

# ==========================================
# Logs
# ==========================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Operating System Files
# ==========================================

.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# IDE & Editor Files
# ==========================================

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# AI Tool Local Configuration
# ==========================================

.claude/

# ==========================================
